# Sunucu portu
PORT=3001

# Admin paneli şifresi (zorunlu, en az 12 karakter)
ADMIN_PASSWORD=degistir-beni-lutfen

# Oturum çerezlerini imzalamak için gizli anahtar (boş bırakılırsa her açılışta rastgele üretilir,
# bu durumda sunucu yeniden başlayınca adminler tekrar giriş yapar)
SESSION_SECRET=

# Veritabanı dosyası
DATABASE_PATH=./data/gbt.sqlite

# Sunucu bir reverse proxy (nginx, Caddy, Render vb.) arkasındaysa 1 yapın
TRUST_PROXY=0

# 10 dakikalık gönderim limitleri.
# Asıl sınır CİHAZ başınadır; okul Wi-Fi'ında yüzlerce kişi aynı IP'yi paylaşır.
# IP limitleri yalnızca tek kaynaktan gelen sele karşı yüksek tavandır.
RATE_LIMIT_SUGGESTIONS_PER_DEVICE=5
RATE_LIMIT_SUGGESTIONS=300
RATE_LIMIT_VISITS_PER_DEVICE=60
RATE_LIMIT_VISITS=5000
